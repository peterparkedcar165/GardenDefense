  - nodes:
    - id: node3a_bombgrassdot
      nodeName: Thorned Husk
      description: The Acorn Sprout periodically deals Grass Physical damage, from the Acorn Bomb's location within its taunt radius, equal to 25% of the Acorn Bomb's Armor, every second.
      maxRank: 1
      costPerRank: 2
      effects: []
      unlockId: acorn_bomb_grass_dot
    - id: node3b_bombmagicarmor
      nodeName: Reinforced Husk
      description: The Acorn Bomb gains 100 Magic Armor.
      maxRank: 1
      costPerRank: 2
      effects: []
      unlockId: acorn_bomb_magic_armor
